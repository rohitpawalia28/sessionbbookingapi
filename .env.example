# Port the API listens on
PORT=5000

# MongoDB connection string (local MongoDB 5.0+ or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/session-booking

# IANA time zone used to decide which calendar day a timestamp belongs to
# in GET /sessions/available (e.g. Asia/Kolkata, UTC, America/New_York)
APP_TIMEZONE=Asia/Kolkata

# development | production (production hides internal error details)
NODE_ENV=development
