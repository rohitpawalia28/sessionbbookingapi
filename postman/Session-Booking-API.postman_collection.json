    {
      "name": "API 3 - Available Sessions for a date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "available"
          ],
          "query": [
            {
              "key": "dateTimestamp",
              "value": "{{dateTimestamp}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "const found = json.data.find(s => s._id === pm.collectionVariables.get(\"sessionId\"));",
              "pm.test(\"New session is listed\", () => pm.expect(found).to.be.an(\"object\"));",
              "pm.test(\"Every session is AVAILABLE\", () => json.data.forEach(s => pm.expect(s.status).to.eql(\"AVAILABLE\")));",
              "pm.test(\"Teacher details are joined\", () => pm.expect(found.teacher.fullName).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
