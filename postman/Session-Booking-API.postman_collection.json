    {
      "name": "API 2 - Create Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A one-hour slot starting tomorrow at the current hour (rounded down)",
              "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "start.setMinutes(0, 0, 0);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set(\"startTime\", start.toISOString());",
              "pm.collectionVariables.set(\"endTime\", end.toISOString());",
              "pm.collectionVariables.set(\"dateTimestamp\", String(start.getTime()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test(\"Default status is AVAILABLE\", () => pm.expect(json.data.status).to.eql(\"AVAILABLE\"));",
              "pm.test(\"userId is null\", () => pm.expect(json.data.userId).to.eql(null));",
              "pm.collectionVariables.set(\"sessionId\", json.data._id);"
            ]
          }
        }
      ]
    },
